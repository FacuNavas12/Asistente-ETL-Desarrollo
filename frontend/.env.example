# URL base del backend FastAPI. Cambiar en producción.
# El frontend usa import.meta.env.VITE_API_BASE con fallback a http://localhost:8000.
VITE_API_BASE=http://localhost:8000

# ── Autenticación de la API (Marco AGESIC 5.0 — función Proteger) ────────────
# VITE_AUTH_REQUIRED=false  → sin tokens (modo desarrollo, valor por defecto).
# VITE_AUTH_REQUIRED=true   → el frontend obtiene un JWT de Auth0 y lo envía
#                             como Authorization: Bearer en cada llamada a la API.
VITE_AUTH_REQUIRED=false

# Identificador de la API en Auth0 (Applications → APIs → Identifier).
# Requerido cuando VITE_AUTH_REQUIRED=true para que Auth0 emita JWT (no token opaco).
# En producción, reemplazar por el identificador del proveedor de identidad corporativo.
VITE_AUTH0_AUDIENCE=
