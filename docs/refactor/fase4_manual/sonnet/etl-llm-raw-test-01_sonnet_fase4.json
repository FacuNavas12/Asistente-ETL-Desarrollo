          },
          {
            "orden": 11,
            "tipo_step_pdi": "TableOutput",
            "nombre": "Cargar stg_tienda_producto",
            "descripcion": "Escribe el stream de productos en la tabla stg_tienda_producto con truncate previo (carga full)."
          }
