          }
        ],
        "steps": [
          {
            "name": "Leer stg_tienda_categoria",
            "type": "TableInput",
            "config": {
              "connection": "conn_staging",
              "sql": "SELECT COALESCE(cod_categoria, 'DESCONOCIDO') AS cod_categoria, COALESCE(nombre_categoria, 'DESCONOCIDO') AS nombre_categoria, stg_fecha_carga, stg_origen, stg_estado FROM stg_tienda_categoria WHERE stg_estado = 'ACTIVO'"
            }
          },
          {
            "name": "Log Categorias Leidas",
            "type": "WriteToLog",
            "config": {
              "level": "Basic",
              "message": "KTR_2 - Categorias leidas desde staging",
              "fields": [
                "cod_categoria",
                "nombre_categoria"
              ]
            }
          },
          {
            "name": "Cargar dim_categoria",
            "type": "DimensionLookup",
            "config": {
              "connection": "conn_dwh",
              "table": "dim_categoria",
              "return_field": "sk_categoria",
              "update": "Y",
              "keys": [
                {
                  "stream_field": "cod_categoria",
                  "table_field": "id_categoria_origen"
                }
              ],
              "fields": [
                {
                  "stream_field": "nombre_categoria",
                  "table_field": "nombre_categoria",
                  "type": "Update"
                }
              ],
              "date_from": "fecha_inicio",
              "date_to": "fecha_fin",
              "version_field": "version"
            }
          },
          {
            "name": "Leer stg_tienda_producto",
            "type": "TableInput",
            "config": {
              "connection": "conn_staging",
              "sql": "SELECT COALESCE(cod_producto, 'DESCONOCIDO') AS cod_producto, COALESCE(nombre_producto, 'DESCONOCIDO') AS nombre_producto, COALESCE(categoria, 'DESCONOCIDO') AS categoria, CASE WHEN precio_lista < 0 THEN NULL ELSE CAST(precio_lista AS NUMERIC(15,2)) END AS precio_lista, CASE WHEN precio_unitario < 0 THEN NULL ELSE CAST(precio_unitario AS NUMERIC(15,2)) END AS precio_unitario, stock, COALESCE(bk_producto, '') AS bk_producto_origen, stg_fecha_carga, stg_origen, stg_estado FROM stg_tienda_producto WHERE stg_estado = 'ACTIVO'"
            }
          },
          {
            "name": "Log Productos Leidos",
            "type": "WriteToLog",
            "config": {
              "level": "Basic",
              "message": "KTR_2 - Productos leidos desde staging",
