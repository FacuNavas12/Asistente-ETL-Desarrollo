                "nombre_producto",
                "categoria",
                "precio_lista",
                "precio_unitario",
                "stock"
              ]
            }
          },
          {
            "name": "Filtrar Precios Negativos",
            "type": "FilterRows",
            "config": {
              "field": "precio_lista",
              "operator": "IS NULL OR >= 0",
              "value": "0",
              "true_target": "Generar BK Producto",
              "false_target": "Descartar Precios Invalidos"
            }
          },
          {
            "name": "Descartar Precios Invalidos",
            "type": "Dummy",
            "config": {}
          },
          {
            "name": "Generar BK Producto",
            "type": "ConcatFields",
            "config": {
              "target_field": "bk_producto_calculado",
              "separator": "-",
              "fields": [
                "categoria",
                "cod_producto"
              ]
            }
          },
          {
            "name": "Cast Tipos Producto",
            "type": "SelectValues",
            "config": {
              "cast": [
                {
                  "name": "precio_lista",
                  "type": "BigNumber"
                },
                {
                  "name": "precio_unitario",
                  "type": "BigNumber"
                }
              ]
            }
          },
          {
            "name": "Lookup FK Categoria en Producto",
            "type": "DimensionLookup",
            "config": {
              "connection": "conn_dwh",
              "table": "dim_categoria",
              "return_field": "sk_categoria",
              "update": "N",
              "keys": [
                {
                  "stream_field": "categoria",
                  "table_field": "id_categoria_origen"
                }
              ],
              "date_from": "fecha_inicio",
