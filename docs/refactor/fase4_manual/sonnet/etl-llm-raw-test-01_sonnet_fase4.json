    "ktr_1": {
      "proceso_etl": {
        "nombre": "KTR_1 — Carga Origen a Staging: Categorías y Productos (Tienda Online)",
        "descripcion": "Lee las tablas 'categorias' y 'productos' del sistema origen, agrega campos de auditoría de staging (stg_origen, stg_fecha_carga) y carga el resultado en las tablas stg_tienda_categoria y stg_tienda_producto con truncate previo. No aplica reglas de negocio.",
        "steps": [
          {
            "orden": 1,
            "tipo_step_pdi": "GetSystemInfo",
            "nombre": "Obtener Fecha de Carga",
            "descripcion": "Genera la fecha/hora de inicio de la corrida ETL para usarla como stg_fecha_carga en ambas ramas."
          },
          {
            "orden": 2,
            "tipo_step_pdi": "TableInput",
            "nombre": "Leer Categorias",
            "descripcion": "Lee todas las filas de la tabla 'categorias' del sistema origen con sus columnas explícitas."
          },
          {
            "orden": 3,
            "tipo_step_pdi": "Constant",
            "nombre": "Constantes Auditoria Categorias",
            "descripcion": "Agrega los campos de auditoría stg_origen='categorias' y stg_estado='ACTIVO' a cada fila de categorías."
          },
          {
            "orden": 4,
            "tipo_step_pdi": "JoinRows",
            "nombre": "Join Fecha Categorias",
            "descripcion": "Producto cartesiano entre la fila de fecha de carga (1 fila) y el stream de categorías para propagar stg_fecha_carga a cada fila."
          },
          {
            "orden": 5,
            "tipo_step_pdi": "SelectValues",
            "nombre": "Seleccionar Campos Categorias",
            "descripcion": "Selecciona y ordena los campos finales del stream de categorías alineados al DDL de stg_tienda_categoria."
          },
          {
            "orden": 6,
            "tipo_step_pdi": "TableOutput",
            "nombre": "Cargar stg_tienda_categoria",
            "descripcion": "Escribe el stream de categorías en la tabla stg_tienda_categoria con truncate previo (carga full)."
          },
          {
            "orden": 7,
            "tipo_step_pdi": "TableInput",
            "nombre": "Leer Productos",
            "descripcion": "Lee todas las filas de la tabla 'productos' del sistema origen con sus columnas explícitas."
          },
          {
            "orden": 8,
            "tipo_step_pdi": "Constant",
