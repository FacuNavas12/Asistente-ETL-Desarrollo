    <sql>SELECT COALESCE(cod_producto, 'DESCONOCIDO') AS cod_producto, COALESCE(nombre_producto, 'DESCONOCIDO') AS nombre_producto, COALESCE(categoria, 'DESCONOCIDO') AS categoria, CASE WHEN precio_lista &lt; 0 THEN NULL ELSE CAST(precio_lista AS NUMERIC(15,2)) END AS precio_lista, CASE WHEN precio_unitario &lt; 0 THEN NULL ELSE CAST(precio_unitario AS NUMERIC(15,2)) END AS precio_unitario, stock, COALESCE(bk_producto, '') AS bk_producto_origen, stg_fecha_carga, stg_origen, stg_estado FROM stg_tienda_producto WHERE stg_estado = 'ACTIVO'</sql>
