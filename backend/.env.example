# Copiar este archivo como .env y completar los valores
# NUNCA commitear el archivo .env

# ── Proveedor LLM ─────────────────────────────────────────────────────────────
# Cambiá solo esta variable para switchear de proveedor. No hay otro cambio necesario.
# Opciones: "gemini" | "anthropic"
LLM_PROVIDER=gemini

# ── Google Gemini ──────────────────────────────────────────────────────────────
GOOGLE_API_KEY=AIza...
# Modelo para generación ETL e inferencia (también usado para validación/documentación).
# Opciones sugeridas: 
GEMINI_MODEL=

# ── Proveedor Gemini ─────────────────────────────────────────────────────────
# "google-ai-studio"  → API key simple, procesa en EE.UU., sin control de región.
#                       Válido para desarrollo y prototipo (API gratuita).
# "vertex-ai"         → Vertex AI SDK, región configurable, DPA enterprise.
#                       Requerido para clientes estatales con restricciones de soberanía.
GEMINI_PROVIDER=google-ai-studio

# Requerido cuando GEMINI_PROVIDER=vertex-ai.
# Obtener en Google Cloud Console → proyecto habilitado con Vertex AI API.
GCP_PROJECT_ID=

# Región de inferencia cuando GEMINI_PROVIDER=vertex-ai.
# Canadá (adecuación GDPR equivalente a Uruguay):
#   northamerica-northeast1  (Montréal)
#   northamerica-northeast2  (Toronto)
# UE (GDPR):  europe-west4  (Países Bajos)
GCP_LOCATION=northamerica-northeast1

# ── Anthropic Claude ───────────────────────────────────────────────────────────
# Solo requerido cuando LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...
# Opciones sugeridas: claude-sonnet-4-6 | claude-opus-4-8
ANTHROPIC_MODEL=claude-sonnet-4-6
# Residencia geográfica de inferencia (Ley 18.331 — adecuación equivalente a Uruguay).
# "ca" → Canadá (PIPEDA). Requiere Claude Enterprise o acuerdo DPA con Anthropic.
ANTHROPIC_INFERENCE_REGION=ca

# ── Timeout de llamadas al LLM ────────────────────────────────────────────────
# Segundos por intento. El SDK de Anthropic usa ~600s por defecto; con los 4
# reintentos del wrapper, un stream colgado (sin datos, sin error) podía dejar
# un job "pending" hasta ~40 min antes de fallar. Bajalo si querés fallar más
# rápido, subilo si tus generaciones legítimas (schemas grandes) tardan más.
# LLM_REQUEST_TIMEOUT_S=240

# ── Conexiones del .ktr generado ──────────────────────────────────────────────
# Y (default): la transformación se marca "database transactional" en Spoon —
# comparte UNA conexión física por nombre de conexión entre todos los steps que
# la usan, en vez de una conexión por step. Evita agotar el pool de la BD
# destino sin importar cuántos steps de BD tenga la transformación.
# SHARED_CONNECTIONS=true

# ── Base de datos de la aplicación ────────────────────────────────────────────
# Dev local: SQLite (sin instalacion, archivo app.db en backend/). Default si se omite.
# Prod: postgresql+psycopg://user:pass@localhost:5432/etl_db (driver: psycopg v3)
DATABASE_URL=sqlite:///./app.db

# ── Autenticación de la API (Marco AGESIC 5.0 — función Proteger) ────────────
# AUTH_REQUIRED=false  → sin validación (modo desarrollo, valor por defecto).
# AUTH_REQUIRED=true   → exige Bearer JWT válido en cada request. Requiere
#                        configurar las tres vars siguientes.
AUTH_REQUIRED=false

# URL del endpoint JWKS del proveedor de identidad:
#   Auth0 (prototipo):  https://<tenant>.auth0.com/.well-known/jwks.json
#   Azure AD / Entra:   https://login.microsoftonline.com/<tenant>/discovery/v2.0/keys
#   Keycloak:           https://<host>/realms/<realm>/protocol/openid-connect/certs
AUTH_JWKS_URL=

# Identificador de la API registrado en el proveedor (claim "aud" del JWT).
# En Auth0: Applications → APIs → Identifier
AUTH_AUDIENCE=

# Issuer del token (claim "iss"). Auth0: https://<tenant>.auth0.com/
AUTH_ISSUER=
